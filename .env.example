# Eros AI - Environment Variables
# Copy to .env and fill values

APP_NAME=Eros AI
DEBUG=false
HOST=0.0.0.0
PORT=8080

# Feature Flags (true/false)
DEEP_AST_ANALYSIS=false
AUTO_PATCH_GENERATION=false
STRICT_COMPLIANCE_MODE=false

# Microsoft Foundry IQ (leave empty for local-only analysis)
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=gpt-4o

# Analysis limits
MAX_CODE_LENGTH=50000
ANALYSIS_TIMEOUT_SECONDS=60
MAX_TOKENS_PER_ANALYSIS=4096
